# Continue with Google.
# This file is not a complete environment catalog. It only documents the
# Google Identity Services client id used by login and invite signup.

# Public client id (ends with .apps.googleusercontent.com).
# When unset, the Continue with Google button is hidden.
# Add the dashboard origin to this client's authorized JavaScript origins.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional server-side audience for verifying the ID token on invite signup.
# Falls back to NEXT_PUBLIC_GOOGLE_CLIENT_ID. Same client id, not a secret.
GOOGLE_CLIENT_ID=
